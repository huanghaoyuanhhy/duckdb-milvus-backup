# name: test/sql/milvus_backup_scan.test
# description: milvus_backup_scan(root_path, backup_name, collection) reads binlog rows with tombstones applied
# group: [milvus]

# Before we load the extension, this will fail
statement error
SELECT * FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items');
----

require milvus_backup

# The fixtures are generated by test/fixtures/generate_scan_fixtures.py:
# scan_v1 is a storage-v1 backup (envelope binlogs) with a nullable VARCHAR
# field, a field split across two binlog files, a pre-group_id segment laid
# out in the old on-disk shape, RowID logs recorded without a fieldID, a
# segment-local delta log and a collection-level L0 delta; scan_v2 is a
# storage-v2 backup whose data lives in one multi-column parquet group file
# with SMALLINT nulls, a LIST column, a sparse vector, JSON and geometry
# fields.

# -- addressing and error paths -------------------------------------------

statement error
SELECT * FROM milvus_backup_scan('test/fixtures/backups', 'missing-backup', 'items');
----

statement error
SELECT * FROM milvus_backup_scan('test/fixtures/backups', 'scan_v1', 'no_such');
----

# Snapshot backups carry no segment meta and are rejected up front.
statement error
SELECT * FROM milvus_backup_scan('test/fixtures/backups', 'gamma', 'anything');
----

statement error
SELECT * FROM milvus_backup_scan('test/fixtures/backups', 'scan_v1', NULL);
----

# -- scan_v1: storage-v1 envelope binlogs ----------------------------------

# Raw rows: 3 (segment 101) + 2 (segment 102) + 2 (segment 103, old layout).
query I
SELECT count(*) FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items', apply_deletes = false);
----
7

# Tombstones: segment delta kills pk 1, collection-level L0 kills pk 3.
query I
SELECT count(*) FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items');
----
5

query IIT
SELECT id, score, tag FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items') ORDER BY id;
----
0	10	a
2	12	c
4	14	e
5	15	NULL
6	16	f

# Rows are NULL, not missing, for a field without binlogs in a segment.
query I
SELECT count(*) FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items') WHERE tag IS NULL;
----
1

# Multi-file fields concatenate in meta order and align with other fields.
query II
SELECT id, score FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items', apply_deletes = false) WHERE id < 3 ORDER BY id;
----
0	10
1	11
2	12

# System columns come from the unattributed RowID log and the timestamp log.
query III
SELECT id, __row_id, __timestamp FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items', include_system = true, apply_deletes = false) WHERE id <= 1 ORDER BY id;
----
0	1000	50
1	1001	55

# Projection pushdown: selecting only the pk must not decode the vector-free
# rest (spot-check the shape instead of timing).
query I
SELECT count(*) FROM milvus_backup_scan('test/fixtures/scan', 'scan_v1', 'items') WHERE id > 1000;
----
0

# -- scan_v2: storage-v2 bare parquet group file ----------------------------

query IIIIIIIT
SELECT id, small::BIGINT, arr::VARCHAR, len(struct_extract(sparse, 'indices'))::BIGINT AS nnz, list_extract(struct_extract(sparse, 'indices'), 1)::BIGINT AS idx0, list_extract(struct_extract(sparse, 'values'), 1)::VARCHAR AS val0, octet_length(geom)::BIGINT AS geom_len, flag::INT FROM milvus_backup_scan('test/fixtures/scan', 'scan_v2', 'metrics') ORDER BY id;
----
0	NULL	[1, 2]	2	0	1.5	4	1
1	7	NULL	1	3	0.5	4	0
2	NULL	[]	0	NULL	NULL	4	1
3	9	[3]	1	1	1.0	4	0

# -- two-argument overload: the path is the backup directory itself -----------

# Same rows as the three-key form; tombstones applied by default too.
query IIT
SELECT id, score, tag FROM milvus_backup_scan('test/fixtures/scan/scan_v1', 'items') ORDER BY id;
----
0	10	a
2	12	c
4	14	e
5	15	NULL
6	16	f

# Named options work in the two-argument form.
query I
SELECT count(*) FROM milvus_backup_scan('test/fixtures/scan/scan_v1', 'items', apply_deletes = false);
----
7

query II
SELECT id, __row_id FROM milvus_backup_scan('test/fixtures/scan/scan_v1', 'items', include_system = true, apply_deletes = false) WHERE id = 0;
----
0	1000

query II
SELECT id, small::BIGINT FROM milvus_backup_scan('test/fixtures/scan/scan_v2', 'metrics') WHERE id = 1 ORDER BY id;
----
1	7

# A root (or any directory without meta/backup_meta.json) is not a backup:
# the two-argument form errors instead of guessing.
statement error
SELECT * FROM milvus_backup_scan('test/fixtures/scan', 'items');
----

statement error
SELECT * FROM milvus_backup_scan('test/fixtures/does-not-exist', 'items');
----

# The collection argument stays mandatory and constant.
statement error
SELECT * FROM milvus_backup_scan('test/fixtures/scan/scan_v1', NULL);
----
